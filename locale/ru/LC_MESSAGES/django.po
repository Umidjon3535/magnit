msgstr "Код для входа в Magnit"

#: core/services/telegram.py
msgid "🔐 %(action)s: <code>%(code)s</code>\n\n%(hint)sKod %(minutes)s daqiqa amal qiladi. Uni hech kimga bermang — Magnit xodimlari kodni hech qachon so'ramaydi.\n\nBu so'rovni siz yubormagan bo'lsangiz, xabarni e'tiborsiz qoldiring."
msgstr "🔐 %(action)s: <code>%(code)s</code>\n\n%(hint)sКод действует %(minutes)s минут. Никому его не сообщайте — сотрудники Magnit никогда не спрашивают код.\n\nЕсли вы не запрашивали код, просто проигнорируйте сообщение."

#: core/services/telegram.py
msgid "Kirish yoki ro'yxatdan o'tish uchun saytdagi Telegram tugmasini bosing."
msgstr "Чтобы войти или зарегистрироваться, нажмите кнопку Telegram на сайте."

#: core/services/telegram.py
msgid "Kodni saytga kiriting, so'ng ism-familiyangizni yozing — hisobingiz yaratiladi."
msgstr "Введите код на сайте, затем укажите имя и фамилию — аккаунт будет создан."

#: core/services/telegram.py
msgid "Assalomu alaykum! 👋\n\nMagnit'ga kirish uchun pastdagi <b>«📱 Raqamni yuborish»</b> tugmasini bosing — kirish kodi shu yerga keladi."
msgstr "Здравствуйте! 👋\n\nЧтобы войти в Magnit, нажмите кнопку <b>«📱 Отправить номер»</b> ниже — код для входа придёт сюда."

#: core/services/telegram.py
msgid "📱 Raqamni yuborish"
msgstr "📱 Отправить номер"

#: core/services/telegram.py
msgid "Assalomu alaykum, %(name)s! 👋\n\nRo'yxatdan o'tish uchun saytda <b>+%(phone)s</b> raqami kiritildi. Tasdiqlash uchun pastdagi <b>«📱 Raqamni yuborish»</b> tugmasini bosing."
msgstr "Здравствуйте, %(name)s! 👋\n\nДля регистрации на сайте указан номер <b>+%(phone)s</b>. Чтобы подтвердить его, нажмите кнопку <b>«📱 Отправить номер»</b> ниже."

#: core/services/telegram.py
msgid "Faqat o'zingizning raqamingizni yuboring — pastdagi tugmadan foydalaning."
msgstr "Отправьте только свой номер — используйте кнопку ниже."

#: core/services/telegram.py
msgid "Ariza topilmadi yoki muddati o'tgan. Saytda Telegram tugmasini qaytadan bosing."
msgstr "Запрос не найден или истёк. Нажмите кнопку Telegram на сайте ещё раз."

#: core/services/telegram.py
msgid "Bu Telegram hisobi <b>+%(tg)s</b> raqamiga bog'langan, saytda esa <b>+%(site)s</b> kiritilgan.\n\nSaytda Telegram'ingizdagi raqamni kiriting."
msgstr "Этот аккаунт Telegram привязан к номеру <b>+%(tg)s</b>, а на сайте указан <b>+%(site)s</b>.\n\nУкажите на сайте номер вашего Telegram."

