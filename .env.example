# Nusxa oling: .env.example -> .env
DJANGO_SECRET_KEY=bu-yerga-uzun-tasodifiy-kalit
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# AI-yordamchi va chek/PDF tahlili uchun (bo'sh qolsa — oflayn rejim)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Aloqa ma'lumotlari (bo'sh qolsa — saytda ko'rsatilmaydi)
SUPPORT_EMAIL=
SUPPORT_TELEGRAM=
SUPPORT_PHONE=

# Telegram-bot (@BotFather'dan oling). Ro'yxatdan o'tish kodi shu bot orqali keladi.
# Botni ishga tushirish: .\.venv\Scripts\python manage.py telegram_bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Serverda (Vercel) webhook uchun maxfiy kalit — istalgan uzun tasodifiy satr
TELEGRAM_WEBHOOK_SECRET=

# --- Faqat serverda (Vercel → Settings → Environment Variables) ---
# DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=magnit.vercel.app
# DATABASE_URL=postgresql://...   (Neon integratsiyasi o'zi qo'shadi)
# BLOB_READ_WRITE_TOKEN=...        (Vercel Blob o'zi qo'shadi)
